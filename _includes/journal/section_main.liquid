{% comment %}
  Section order (1-3): Futures, Interviews, Deep Dive.
  Categories are concatenated as clean, label-grouped blocks in this order.
  Each sublist is already sorted by article-order (see assigns.liquid), so we
  intentionally do NOT re-sort the combined list — a global sort would
  interleave the categories instead of keeping them as distinct blocks.
  Reconsider (rethink) lives in its own section: section_rethink.liquid.
{% endcomment %}
{% assign articles_mixed = articles_futures
                 | concat: articles_interviews
                 | concat: articles_deep_dives
                 | uniq %}

{% comment %}
  From volume 2 on, each category gets its own full-width colour band
  (.category-group.category-<slug>), coloured by the volume's stylesheet.
  Volume 1 keeps the single mixed grid. This used to check the URL for
  "wilder-journal-2" only, so volume 3's section colours never applied.
{% endcomment %}
{% assign grouped_sections = false %}
{% if current_volume_number >= 2 %}
  {% assign grouped_sections = true %}
{% endif %}

<section id="main" class="pj-articles container-fluid{% if grouped_sections %} wilder-journal-{{ current_volume_number }}{% endif %}">
  {% if grouped_sections %}
    {% assign current_category = "" %}
    {% assign row_open = false %}
    {% for article in articles_mixed %}

      {% if article.category != current_category %}
        {% if row_open %}
          </div>
          {% assign row_open = false %}
        {% endif %}
        {% unless forloop.first %}
            </div>
          </div>
        {% endunless %}
        <div class="category-group category-{{ article.category | slugify }}">
          <div class="container grid">
        {% assign current_category = article.category %}
        {% assign category_mod = 0 %}
      {% endif %}

      {% assign mod = category_mod | modulo: 2 %}
      {% if mod == 0 %}
        <div class="row-articles">
        {% assign row_open = true %}
      {% endif %}

      {% capture class %}
        highlighted-{% if mod == 0 %}vertical{% else %}horizontal{% endif %}
        highlighted-{{ article.category | slugify }}
      {% endcapture %}

      {% assign category_name = site.data.i18n[page.locale].categories[article.category] %}
      {% assign category_archive = site.archives | where: "locale", page.locale | where: "category", article.category | first %}

      <article class="highlighted {{ class }}" data-href="{{ article.url | relative_url }}">
        <img src="{{ article.cover.thumbnail | relative_url }}" alt="{{ article.cover.alt }}" style="--aspect-ratio:1">

        <h4>
          <a href="{{ category_archive.url  | relative_url }}">{{ category_name }}</a>
        </h4>

        <h3>
          <a href="{{ article.url | relative_url }}">
            {% if article.category == "interviews" %}
              <span class="interviewee">{{ article.interviewee }}</span>
            {% endif %}
            {{ article.title }}
          </a>
        </h3>
      </article>

      {% if mod != 0 %}
        </div>
        {% assign row_open = false %}
      {% endif %}

      {% assign category_mod = category_mod | plus: 1 %}

      {% if forloop.last %}
        {% if row_open %}
          </div>
        {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% else %}
    <div class="container grid">
      {% for article in articles_mixed %}
        {% assign mod = forloop.index0 | modulo: 2 %}
          {% if mod == 0 %}
            <div class="row-articles">
          {% endif %}

          {% capture class %}
            highlighted-{% if mod == 0 %}vertical{% else %}horizontal{% endif %}
            highlighted-{{ article.category | slugify }}
          {% endcapture %}

          {% assign category_name = site.data.i18n[page.locale].categories[article.category] %}
          {% assign category_archive = site.archives | where: "locale", page.locale | where: "category", article.category | first %}

          <article class="highlighted {{ class }}" data-href="{{ article.url | relative_url }}">
            <img src="{{ article.cover.thumbnail | relative_url }}" alt="{{ article.cover.alt }}" style="--aspect-ratio:1">

            <h4>
              <a href="{{ category_archive.url  | relative_url }}">{{ category_name }}</a>
            </h4>

            <h3>
              <a href="{{ article.url | relative_url }}">
                {% if article.category == "interviews" %}
                  <span class="interviewee">{{ article.interviewee }}</span>
                {% endif %}
                {{ article.title }}
              </a>
            </h3>
          </article>
        {% if mod != 0 %}
          </div>
        {% elsif forloop.last == true %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>
